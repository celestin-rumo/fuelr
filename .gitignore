# Node
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.next/
# The e2e run builds into its own directory — never the dev server's, or it
# wipes the chunks the loaded pages reference. See next.config.ts.
frontend/.next-e2e/
frontend/.nuxt/
frontend/.output/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
.angular/

# Spring Boot / Maven
backend/target/
# (no bare `target/`: it would also swallow any route or folder called
#  "target", which is how the nutrition preview route stayed untracked.)

# Environment / secrets
.env
.env.*
!.env.*.example

# OS
.DS_Store

# Logs
*.log

# Downloaded food-composition workbooks. The generated CSVs are committed; the
# 3 MB of source spreadsheets are not — see tools/food-table/SOURCE.md.
tools/food-table/cache/
