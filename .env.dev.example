# Local dev host ports. Copy to `.env` and change only what collides with
# another project already running on this machine — Compose picks `.env` up
# automatically, so the run command stays:
#
#   docker compose -f docker-compose.dev.yml up --build
#
# Container-internal ports never change, so nothing in the app is affected.
FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5432
MAILPIT_PORT=8025
MAILPIT_SMTP_PORT=1025

# Anthropic, for the assisted import (photo and screenshot). Without it the
# feature says it is not wired rather than failing — see RecipeIntelligence.
ANTHROPIC_API_KEY=
